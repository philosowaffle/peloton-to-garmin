{
  "App": {
    "EnablePolling": true,
    "PollingIntervalSeconds": 86400,
    "CheckForUpdates": true
  },

  "Format": {
    "Fit": false,
    "Json": false,
    "Tcx": false,
    "Gpx": true,
    "SaveLocalCopy": true,
    "IncludeTimeInHRZones": false,
    "IncludeTimeInPowerZones": false,
    "StackedWorkouts": {
      "AutomaticallyStackWorkouts": false,
      "MaxAllowedGapSeconds": 300
    }
  },

  "Strava": {
    "ClientId": 197584,
    "ClientSecret": "",
    "AccessToken": "",
    "RefreshToken": "",
    "TokenExpiresAt": "",
    "NumActivitiesToDownload": 1,
    "ExcludeActivityTypes": []
  },

  "Garmin": {
    "Email": "",
    "Password": "",
    "ServiceTicket": "",
    "TwoStepVerificationEnabled": false,
    "Upload": false,
    "FormatToUpload": "fit"
  },

  "Observability": {

    "Prometheus": {
      "Enabled": false,
      "Port": 4000
    },

    "Jaeger": {
      "Enabled": false,
      "AgentHost": "localhost",
      "AgentPort": 6831
    },

    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Error",
          "System": "Error"
        }
      }
    }
  }
}